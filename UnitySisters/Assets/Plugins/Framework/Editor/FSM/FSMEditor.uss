.fsm-toolbar {
    min-height: 24px;
    padding-left: 4px;
    padding-right: 6px;
}

.fsm-machine-dropdown {
    min-width: 260px;
    flex-grow: 1;
    max-width: 520px;
}

.fsm-data-field {
    min-width: 220px;
    flex-grow: 1;
    max-width: 420px;
}

.fsm-play-status {
    margin-left: auto;
    -unity-font-style: bold;
    color: rgb(120, 190, 145);
}

.fsm-detail-panel {
    min-width: 250px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    background-color: rgb(43, 43, 43);
}

.fsm-section-title {
    height: 25px;
    margin-top: 7px;
    margin-bottom: 5px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(75, 75, 75);
    -unity-font-style: bold;
    font-size: 13px;
}

.fsm-detail-row {
    min-height: 24px;
    flex-direction: row;
    align-items: center;
}

.fsm-detail-name {
    width: 92px;
    color: rgb(170, 170, 170);
}

.fsm-detail-value {
    flex-grow: 1;
    white-space: normal;
}

.fsm-history-list {
    flex-grow: 1;
    margin-top: 3px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(65, 65, 65);
    border-bottom-color: rgb(65, 65, 65);
    border-left-color: rgb(65, 65, 65);
    border-right-color: rgb(65, 65, 65);
}

.fsm-transition-list {
    height: 72px;
    margin-top: 2px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(65, 65, 65);
    border-bottom-color: rgb(65, 65, 65);
    border-left-color: rgb(65, 65, 65);
    border-right-color: rgb(65, 65, 65);
}

.fsm-parameter-list,
.fsm-condition-list {
    height: 96px;
    margin-top: 2px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: rgb(65, 65, 65);
}

.fsm-list-item {
    padding-left: 6px;
    padding-right: 4px;
    -unity-text-align: middle-left;
    font-size: 11px;
}

.fsm-inline-controls {
    min-height: 24px;
    flex-direction: row;
}

.fsm-inline-controls > Button {
    min-width: 72px;
    margin-right: 3px;
}

.fsm-edit-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.fsm-warning-label {
    margin-top: 4px;
    margin-bottom: 4px;
    white-space: normal;
    color: rgb(225, 176, 76);
    font-size: 11px;
}

.fsm-transition-list-item {
    padding-left: 6px;
    -unity-text-align: middle-left;
    font-size: 11px;
}

.fsm-edit-panel {
    margin-top: 8px;
    padding-bottom: 6px;
}

.fsm-edit-panel > .unity-base-field {
    margin-top: 3px;
    margin-bottom: 3px;
}

.fsm-history-item {
    padding-left: 6px;
    padding-right: 4px;
    padding-top: 3px;
    white-space: normal;
    font-size: 11px;
}

.fsm-state-node {
    min-width: 200px;
    max-width: 200px;
    width: 200px;
    min-height: 58px;
    max-height: 58px;
    height: 58px;
    border-width: 0;
    padding: 0;
}

.fsm-state-node #node-border {
    margin: 0;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(24, 24, 24);
    background-color: rgb(74, 76, 80);
}

.fsm-state-node #title {
    min-height: 56px;
    height: 56px;
    border-radius: 3px;
    background-color: rgb(74, 76, 80);
}

.fsm-state-node #title-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 13px;
    color: rgb(225, 225, 225);
}

.fsm-state-node--initial #node-border,
.fsm-state-node--initial #title {
    background-color: rgb(176, 92, 15);
}

.fsm-state-node--transition-source #node-border {
    border-width: 2px;
    border-color: rgb(82, 172, 225);
}

.fsm-state-node--active #node-border {
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-color: rgb(55, 225, 140);
    border-bottom-color: rgb(55, 225, 140);
    border-left-color: rgb(55, 225, 140);
    border-right-color: rgb(55, 225, 140);
}

.fsm-entry-node {
    min-width: 150px;
    max-width: 150px;
    width: 150px;
    min-height: 38px;
    max-height: 38px;
    height: 38px;
    border-width: 0;
    padding: 0;
}

.fsm-entry-node #node-border {
    margin: 0;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(20, 24, 20);
    background-color: rgb(25, 126, 58);
}

.fsm-entry-node #title {
    min-height: 36px;
    height: 36px;
    border-radius: 3px;
    background-color: rgb(25, 126, 58);
}

.fsm-entry-node #title-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: rgb(235, 245, 238);
}

.fsm-hidden-port,
.fsm-hidden-port > #connector {
    position: absolute;
    min-width: 1px;
    max-width: 1px;
    width: 1px;
    min-height: 1px;
    max-height: 1px;
    height: 1px;
    padding: 0;
    margin: 0;
    border-width: 0;
    opacity: 0;
}

.fsm-transition-marker {
    width: 18px;
    height: 18px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.fsm-transition-arrow {
    position: absolute;
    left: 0;
    top: 0;
    width: 18px;
    height: 18px;
}

.fsm-transition-arrow-head {
    position: absolute;
    left: 3px;
    top: 4px;
    width: 9px;
    height: 9px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-color: rgb(220, 222, 225);
    border-right-color: rgb(220, 222, 225);
}
