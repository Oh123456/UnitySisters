.bt-tree-node {
    min-width: 210px;
    max-width: 210px;
    min-height: 120px;
    max-height: 120px;
}

.bt-tree-node #node-border {
    background-color: rgb(74, 76, 80);
    border-radius: 4px;
}

.bt-tree-node #title,
.bt-root-node #title {
    min-height: 38px;
    background-color: rgb(74, 76, 80);
}

.bt-tree-node #title-label,
.bt-root-node #title-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: rgb(235, 235, 235);
}

.bt-tree-node #extension {
    padding: 4px;
}

.bt-root-node {
    min-width: 150px;
    max-width: 150px;
    min-height: 42px;
    max-height: 42px;
}

.bt-root-node #node-border,
.bt-root-node #title {
    background-color: rgb(24, 121, 63);
    border-radius: 4px;
}

.bt-hidden-port {
    position: absolute;
    left: 50%;
    top: 50%;
    min-width: 1px;
    max-width: 1px;
    min-height: 1px;
    max-height: 1px;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: 0;
    border-width: 0;
    opacity: 0;
    translate: -50% -50%;
}

.bt-hidden-port #connector {
    position: absolute;
    left: 0;
    top: 0;
    min-width: 1px;
    max-width: 1px;
    min-height: 1px;
    max-height: 1px;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: 0;
    border-width: 0;
    opacity: 0;
}

.bt-connection-source #node-border {
    border-width: 3px;
    border-color: rgb(82, 172, 225);
}

.bt-connection-arrow {
    width: 18px;
    height: 18px;
    background-color: rgba(0, 0, 0, 0);
}

.bt-connection-arrow-head {
    position: absolute;
    left: 4px;
    top: 4px;
    width: 8px;
    height: 8px;
    rotate: 45deg;
    border-top-width: 2px;
    border-right-width: 2px;
    border-top-color: rgb(175, 177, 181);
    border-right-color: rgb(175, 177, 181);
}
